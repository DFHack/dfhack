# Generated from git-describe.cmake.in
set(DFHACK_BUILD_ID "@DFHACK_BUILD_ID@")

# Fallbacks used when the source tree is not a git checkout or when revision
# information cannot be obtained.
set(DFHACK_GIT_DESCRIPTION "@DFHACK_VERSION@-unknown")
set(DFHACK_GIT_COMMIT "unknown")
set(DFHACK_GIT_XML_EXPECTED_COMMIT "unknown")
set(DFHACK_GIT_XML_COMMIT "unknown")
set(DFHACK_GIT_TAGGED FALSE)
set(DFHACK_GIT_XML_MATCH FALSE)

if(EXISTS "${dfhack_SOURCE_DIR}/.git")
    if(NOT GIT_EXECUTABLE OR NOT EXISTS "${GIT_EXECUTABLE}")
        message(WARNING "git-describe: could not find git; version information will be unavailable")
    else()
        execute_process(COMMAND ${GIT_EXECUTABLE} describe --tags --abbrev=8 --long
            WORKING_DIRECTORY "${dfhack_SOURCE_DIR}"
            OUTPUT_VARIABLE DFHACK_GIT_DESCRIPTION
            OUTPUT_STRIP_TRAILING_WHITESPACE
            RESULT_VARIABLE DFHACK_GIT_DESCRIPTION_RESULT)
        execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse HEAD
            WORKING_DIRECTORY "${dfhack_SOURCE_DIR}"
            OUTPUT_VARIABLE DFHACK_GIT_COMMIT
            OUTPUT_STRIP_TRAILING_WHITESPACE)
        execute_process(COMMAND ${GIT_EXECUTABLE} describe --tags --abbrev=8 --exact-match
            WORKING_DIRECTORY "${dfhack_SOURCE_DIR}"
            RESULT_VARIABLE DFHACK_GIT_TAGGED_RESULT
            OUTPUT_QUIET ERROR_QUIET)

        # Check library/xml for matching commits
        execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse HEAD:library/xml
            WORKING_DIRECTORY "${dfhack_SOURCE_DIR}"
            OUTPUT_VARIABLE DFHACK_GIT_XML_EXPECTED_COMMIT
            OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(EXISTS "${dfhack_SOURCE_DIR}/library/xml/.git")
            execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse HEAD
                WORKING_DIRECTORY "${dfhack_SOURCE_DIR}/library/xml"
                OUTPUT_VARIABLE DFHACK_GIT_XML_COMMIT
                OUTPUT_STRIP_TRAILING_WHITESPACE)
        endif()

        if(DFHACK_GIT_TAGGED_RESULT STREQUAL "0")
            set(DFHACK_GIT_TAGGED TRUE)
        endif()

        if(NOT "${DFHACK_GIT_XML_COMMIT}" STREQUAL ""
                AND NOT "${DFHACK_GIT_XML_COMMIT}" STREQUAL "unknown"
                AND "${DFHACK_GIT_XML_COMMIT}" STREQUAL "${DFHACK_GIT_XML_EXPECTED_COMMIT}")
            set(DFHACK_GIT_XML_MATCH TRUE)
        endif()

        if(NOT DFHACK_GIT_DESCRIPTION_RESULT STREQUAL "0")
            # e.g. a clone with no reachable tags; fall back to the commit hash
            message(WARNING "git-describe: 'git describe' failed; using commit hash as description")
            set(DFHACK_GIT_DESCRIPTION "${DFHACK_GIT_COMMIT}")
        endif()
    endif()
endif()

configure_file(${dfhack_SOURCE_DIR}/library/include/git-describe.h.in ${dfhack_SOURCE_DIR}/library/include/git-describe.h)
